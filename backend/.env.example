# Copy to .env for local dev. Production values go in
# /etc/systemd/system/anyspace-backend.service via Environment= directives.

DATABASE_URL=sqlite:///./data/anyspace.db
MODEL_CACHE_DIR=./data/models

LOG_LEVEL=info
LOG_JSON=false                # set true in production

LISTEN_HOST=127.0.0.1
LISTEN_PORT=9100

# Comma-separated CIDRs/IPs whose X-Forwarded-For header we trust.
# Tailscale Funnel forwards from 100.64.0.0/10. Localhost for direct curl.
TRUSTED_PROXY_IPS=127.0.0.1,::1,100.64.0.0/10

# Rate limit (per source IP, phase 1 only — replaced with per-user in phase 2)
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_PER_HOUR=600
MAX_AUDIO_SECONDS=600
MAX_BODY_BYTES=26214400        # 25 MB

# CORS — desktop app uses tauri:// scheme; landing is the marketing domain.
CORS_ALLOW_ORIGINS=tauri://localhost,https://anyspace.dev,https://www.anyspace.dev

# Clerk — JWT verification needs FRONTEND_API + (optionally) JWKS leeway.
# /v1/desktop-bridge/mint-ticket additionally needs SECRET_KEY to call
# Clerk's Backend API. The webhook secret powers /v1/webhooks/clerk.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_FRONTEND_API=
CLERK_WEBHOOK_SIGNING_SECRET=

# Stripe — phase 3 billing. SECRET_KEY + PRICE_ID_MONTHLY are required to
# enable /v1/billing/*; WEBHOOK_SECRET powers /v1/billing/webhook. The
# PRICE_IDs come from the "AnySpace Pro" product in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
STRIPE_CHECKOUT_SUCCESS_URL=https://anyspace.dev/billing/success
STRIPE_CHECKOUT_CANCEL_URL=https://anyspace.dev/billing/cancel
STRIPE_PORTAL_RETURN_URL=https://anyspace.dev/billing/portal-return

# Cloud usage quotas (phase 3 — over-quota returns 402). Free numbers are
# the marketed allowance per calendar month UTC; Pro numbers are a quiet
# fair-use ceiling per Stripe billing period (catches abuse without
# bothering normal users — most Pro users never see them).
FREE_QUOTA_AI_PER_MONTH=200
FREE_QUOTA_STT_SECS_PER_MONTH=1800
PRO_QUOTA_AI_PER_PERIOD=10000
PRO_QUOTA_STT_SECS_PER_PERIOD=18000
