---
import BrandMark from "./BrandMark.astro";
import { FOOTER_COLS } from "../data/footer";
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="container py-16">
    <div class="grid grid-cols-2 gap-y-10 gap-x-8 sm:grid-cols-4">
      <div class="col-span-2 max-w-xs">
        <a href="/" class="inline-flex items-center gap-2.5" aria-label="AnySpace home">
          <BrandMark size={24} class="rounded-md" />
          <span class="text-base font-semibold text-fg">AnySpace</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-fg-muted">
          The agentic workspace. Type less, orchestrate more.
        </p>
        <a
          href="mailto:support@anyspace.dev"
          class="mt-4 inline-flex items-center gap-2 font-mono text-xs text-fg-muted transition-colors duration-fast hover:text-fg"
        >
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
            <polyline points="22,6 12,13 2,6" />
          </svg>
          support@anyspace.dev
        </a>
      </div>

      {FOOTER_COLS.map((c) => (
        <nav aria-label={c.heading} class="flex flex-col gap-3">
          <h4 class="font-mono text-[11px] uppercase tracking-[0.14em] text-fg-dim">{c.heading}</h4>
          <ul class="flex flex-col gap-2.5">
            {c.links.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-fg-muted transition-colors duration-fast hover:text-fg">{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-14 flex items-center justify-between border-t border-border pt-6 font-mono text-xs text-fg-dim">
      <span>© {year} AnySpace</span>
      <span>v0.1.0</span>
    </div>
  </div>
</footer>
