---
import FAQAccordion from "../islands/FAQAccordion.tsx";
---

<section id="faq" class="border-t border-border py-24 sm:py-32">
  <div class="container">
    <div class="mx-auto max-w-3xl">
      <div class="mb-10 text-center">
        <div class="eyebrow mb-5 justify-center inline-flex">FAQ</div>
        <h2 class="text-display text-fg">
          Answers to the things
          <span class="text-fg-muted">you'd ask before paying.</span>
        </h2>
      </div>
      <FAQAccordion client:visible />
    </div>
  </div>
</section>
