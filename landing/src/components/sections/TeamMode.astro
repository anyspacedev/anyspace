---
import AgentToasts from "../islands/AgentToasts.tsx";

const roles = [
  { name: "Coordinator", desc: "Plans, decomposes, assigns. Keeps the team aligned.", icon: "compass" },
  { name: "Builder", desc: "Writes code, runs tests, opens pull requests.", icon: "hammer" },
  { name: "Reviewer", desc: "Reviews diffs, files objections, approves merges.", icon: "check" },
  { name: "Observer", desc: "Watches CI, reports anomalies, escalates to operator.", icon: "eye" },
];
---

<section id="team" class="border-t border-border py-24 sm:py-32">
  <div class="container">
    <div class="grid grid-cols-1 gap-16 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <div class="eyebrow mb-5">Team Mode</div>
        <h2 class="text-display text-fg max-w-xl">
          Agents that talk
          <span class="text-fg-muted">to each other.</span>
        </h2>
        <p class="mt-5 max-w-lg text-base text-fg-muted sm:text-lg">
          Spawn a team with roles, broadcast state through a shared message log,
          and let agents coordinate without you in the middle.
        </p>

        <div class="mt-10 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {roles.map((r) => (
            <div class="rounded-lg border border-border bg-bg-elev/40 p-5">
              <div class="flex h-9 w-9 items-center justify-center rounded-md border border-border bg-bg text-fg">
                {r.icon === "compass" && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
                  </svg>
                )}
                {r.icon === "hammer" && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 12l-8.5 8.5a2.12 2.12 0 0 1-3-3L12 9" />
                    <path d="M17.64 15 22 10.64" />
                    <path d="M20.91 11.7l-1.25-1.25c-.7-.7-.7-1.85 0-2.55l2.05-2.05c-1.83-1.83-4.81-1.83-6.65 0l-1.55 1.55a4.71 4.71 0 0 0 0 6.66l-1.4 1.4" />
                  </svg>
                )}
                {r.icon === "check" && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                  </svg>
                )}
                {r.icon === "eye" && (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                )}
              </div>
              <div class="mt-4 text-base font-medium text-fg">{r.name}</div>
              <p class="mt-1.5 text-sm text-fg-muted">{r.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-xl border border-border bg-bg-elev/40 p-6">
          <div class="mb-5 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.12em] text-fg-muted">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-fg" />
            Broadcast feed
          </div>
          <AgentToasts client:visible />
        </div>
      </div>
    </div>
  </div>
</section>
