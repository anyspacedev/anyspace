---
import OrchestratorCanvas from "../islands/OrchestratorCanvas.tsx";
import { DOWNLOADS } from "../../lib/downloads";
---

<section class="relative pt-28 pb-32 sm:pt-36 sm:pb-40">
  <div class="container relative">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-bg-elev px-3 py-1.5">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-fg" />
        <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-fg-muted">
          Early Access · <span class="text-fg">Free</span>
        </span>
      </div>

      <h1 class="text-display-lg text-fg">
        Type Less.
        <span class="text-fg-muted">Orchestrate More.</span>
      </h1>

      <p class="mt-4 font-mono text-xs uppercase tracking-[0.18em] text-fg-dim">
        — Built for Builders
      </p>

      <p class="mx-auto mt-7 max-w-2xl text-balance text-lg text-fg-muted sm:text-xl">
        Autonomous AI agents collaborating on a multi-panel canvas — terminals,
        editors, previews, and your voice, in one window.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a
          href="#download"
          data-os-cta
          class="inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-fg px-6 font-medium text-bg transition-colors duration-fast ease-out hover:bg-fg/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span data-os-label>Download</span>
        </a>
        <a
          href="https://github.com/anyspacedev/anyspace"
          target="_blank"
          rel="noopener"
          class="inline-flex h-12 items-center justify-center gap-2 rounded-lg border border-border-strong bg-transparent px-6 font-medium text-fg transition-colors duration-fast ease-out hover:bg-bg-elev focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.16-.02-2.11-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18.92-.26 1.9-.39 2.88-.39.98 0 1.96.13 2.88.39 2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" />
          </svg>
          GitHub
        </a>
      </div>

      <p class="mt-5 font-mono text-xs text-fg-dim">
        <a
          href={DOWNLOADS.macArm64}
          data-os-alt="macOS"
          class="underline-offset-4 transition-colors duration-fast hover:text-fg hover:underline"
        >macOS</a><span aria-hidden="true" data-os-alt-sep> · </span><a
          href={DOWNLOADS.windowsX64}
          data-os-alt="Windows"
          class="underline-offset-4 transition-colors duration-fast hover:text-fg hover:underline"
        >Windows</a><span aria-hidden="true" data-os-alt-sep> · </span><a
          href={DOWNLOADS.linuxDeb}
          data-os-alt="Linux"
          class="underline-offset-4 transition-colors duration-fast hover:text-fg hover:underline"
        >Linux</a><span aria-hidden="true" data-os-alt-sep> · </span><a
          href="#download"
          class="underline-offset-4 transition-colors duration-fast hover:text-fg hover:underline"
        >all builds</a>
      </p>
    </div>

    <div class="mt-24">
      <OrchestratorCanvas client:load />
    </div>
  </div>

  <script>
    import { detectOS, downloadLabel } from "../../lib/detectOS";
    import { downloadFor } from "../../lib/downloads";
    const os = detectOS();
    const label = downloadLabel(os);
    const href = downloadFor(os);
    document.querySelectorAll<HTMLAnchorElement>("[data-os-cta]").forEach((a) => {
      a.href = href;
    });
    document.querySelectorAll<HTMLElement>("[data-os-label]").forEach((el) => {
      el.textContent = label;
    });
    // Hide the alt-link (and one adjacent separator) matching the detected OS,
    // so the row reads as "other platforms". Unknown OS leaves all 3 visible.
    if (os !== "Unknown") {
      const matched = document.querySelector<HTMLElement>(`[data-os-alt="${os}"]`);
      if (matched) {
        matched.style.display = "none";
        const next = matched.nextElementSibling as HTMLElement | null;
        const prev = matched.previousElementSibling as HTMLElement | null;
        if (next?.hasAttribute("data-os-alt-sep")) next.style.display = "none";
        else if (prev?.hasAttribute("data-os-alt-sep")) prev.style.display = "none";
      }
    }
  </script>
</section>
