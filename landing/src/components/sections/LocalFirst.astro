---
const platforms = [
  { name: "macOS", icon: "apple" },
  { name: "Linux", icon: "linux" },
  { name: "Windows", icon: "windows" },
];
---

<section id="privacy" class="border-t border-border py-24 sm:py-32">
  <div class="container">
    <div class="mx-auto max-w-3xl text-center">
      <div class="eyebrow mb-5">Privacy</div>
      <h2 class="text-display text-fg">
        Local-first
        <span class="text-fg-muted">by default.</span>
      </h2>
    </div>

    <div class="mx-auto mt-16 grid max-w-5xl grid-cols-1 gap-3 lg:grid-cols-2">
      <div class="rounded-xl border border-border bg-bg-elev/40 p-8 sm:p-10">
        <div class="font-mono text-xs uppercase tracking-[0.12em] text-fg-muted">100% Local</div>
        <h3 class="mt-3 text-2xl font-semibold tracking-tight text-fg">
          Your code, terminals, and conversations stay on your machine.
        </h3>
        <p class="mt-4 text-base text-fg-muted">
          No hidden uploads. No telemetry sneaking into your shell. Everything
          runs against a real PTY on your filesystem.
        </p>
      </div>

      <div class="rounded-xl border border-border bg-bg-elev/40 p-8 sm:p-10">
        <div class="font-mono text-xs uppercase tracking-[0.12em] text-fg-muted">Bring your own keys</div>
        <h3 class="mt-3 text-2xl font-semibold tracking-tight text-fg">
          Use our cloud or plug in your own LLM and STT endpoints.
        </h3>
        <p class="mt-4 text-base text-fg-muted">
          OpenAI, Anthropic, or a local model — same UI. The proxy layer routes
          every request through endpoints you configure.
        </p>
      </div>
    </div>

    <div class="mx-auto mt-12 flex max-w-3xl flex-wrap items-center justify-center gap-x-8 gap-y-4">
      {platforms.map((p) => (
        <div class="flex items-center gap-2.5 text-fg-muted">
          {p.icon === "apple" && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.365 1.43c0 1.14-.493 2.27-1.179 3.087-.74.886-1.951 1.575-3.046 1.487-.13-1.09.402-2.24 1.083-2.96.788-.834 2.139-1.495 3.142-1.614zM21 17.05c-.62 1.38-.918 2-1.72 3.21-1.111 1.69-2.679 3.795-4.622 3.81-1.726.013-2.17-1.118-4.512-1.106-2.341.012-2.83 1.127-4.557 1.114-1.943-.018-3.43-1.917-4.541-3.607C-.114 17.45-.397 13.064 1.42 10.79c1.292-1.62 3.328-2.566 5.243-2.566 1.948 0 3.173 1.066 4.78 1.066 1.557 0 2.504-1.067 4.755-1.067 1.706 0 3.515.93 4.804 2.535-4.225 2.318-3.541 8.366-.002 6.292z" />
            </svg>
          )}
          {p.icon === "linux" && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" />
              <line x1="8" y1="21" x2="16" y2="21" />
              <line x1="12" y1="17" x2="12" y2="21" />
            </svg>
          )}
          {p.icon === "windows" && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3 5.475L10.5 4.5v7H3v-6.025zM10.5 12.5v7L3 18.525V12.5h7.5zM11.5 4.35L21 3v8.5h-9.5v-7.15zM21 12.5V21l-9.5-1.35V12.5H21z" />
            </svg>
          )}
          <span class="text-sm font-medium text-fg">{p.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>
