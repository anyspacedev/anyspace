---
const features = [
  {
    title: "Multi-pane terminals",
    body: "Up to 16 WebGL-rendered terminals per workspace. Split, swap, drag-to-rearrange, and broadcast keystrokes across selected panes — perfect for running parallel agents.",
    icon: "panes",
  },
  {
    title: "Warp-style command blocks",
    body: "OSC 133 shell integration is auto-injected on every spawn — no rc-file edits. Every command becomes a clickable block: copy, re-run, ask AI to explain.",
    icon: "blocks",
  },
  {
    title: "AI agent orchestration",
    body: "Drag a Kanban task to a pane. AnySpace spawns the agent CLI of your choice — Claude Code, Cursor, custom — with task context already injected.",
    icon: "agent",
  },
  {
    title: "Live preview, wired in",
    body: "Auto-detects Vite, Next, Astro, SvelteKit, Nuxt, Remix. Hot-reload on save, device frames, element picker that fires source location into your agent.",
    icon: "preview",
  },
  {
    title: "Monaco editor pane",
    body: "Open files alongside your terminal with the same editor that powers VS Code. Cmd+P fuzzy file open, syntax-aware, themes in lock-step with the terminal.",
    icon: "editor",
  },
  {
    title: "Local-first, private by default",
    body: "Every byte stays on your machine. SQLite storage, no telemetry, BYO API keys for AI features. Optional HTTP/SOCKS5 proxy for outbound calls.",
    icon: "shield",
  },
];

const icons: Record<string, string> = {
  panes: '<rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/>',
  blocks: '<rect x="3" y="4" width="18" height="5" rx="1.5"/><rect x="3" y="11" width="14" height="5" rx="1.5"/><rect x="3" y="18" width="9" height="3" rx="1"/>',
  agent: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/><path d="M9 7h6"/>',
  preview: '<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="2" y1="8" x2="22" y2="8"/><circle cx="5.5" cy="5.5" r="0.7" fill="currentColor"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>',
  editor: '<path d="M14 4l6 6-10 10H4v-6L14 4z"/><path d="M14 4l6 6"/>',
  shield: '<path d="M12 3l8 3v6c0 4.5-3.5 8.5-8 9-4.5-.5-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/>',
};
---

<section class="section" id="features">
  <div class="container">
    <header class="section-head">
      <span class="eyebrow">Features</span>
      <h2>The pieces of your workflow, finally talking to each other.</h2>
      <p class="lead">
        Every feature is wired to send signal to the next. Pick an element in
        the preview, your agent gets the source file. Run a command, the AI
        sees the output. No copy-paste between tools.
      </p>
    </header>

    <ul class="grid">
      {
        features.map((f) => (
          <li class="card feature">
            <span class="feature-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[f.icon]} />
            </span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: clamp(40px, 5vw, 64px);
    max-width: 760px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .feature p {
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.6;
  }
  .feature-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--accent) 12%, var(--bg-elev-2));
    color: var(--accent);
    margin-bottom: 4px;
  }
</style>
