---
// CSS-only mock of the in-app terminal showing two OSC 133 command blocks.
// Used in the Hero to convey the product without needing real screenshots.
---

<div class="term" role="img" aria-label="AnySpace terminal showing two captured command blocks">
  <div class="term-chrome">
    <span class="dot dot-r" aria-hidden="true"></span>
    <span class="dot dot-y" aria-hidden="true"></span>
    <span class="dot dot-g" aria-hidden="true"></span>
    <span class="term-title">~/projects/anyspace — pane 1</span>
  </div>
  <div class="term-body">
    <div class="block">
      <div class="block-head">
        <span class="block-status block-status-ok" aria-hidden="true"></span>
        <span class="block-cmd">
          <span class="prompt">$</span>
          <span>npm run tauri:dev</span>
        </span>
        <span class="block-time">2m 14s</span>
      </div>
      <div class="block-out">
        <span class="line muted">› vite v5.4.0 ready in <span class="num">412</span> ms</span>
        <span class="line muted">› Local: <span class="hl">http://localhost:1420</span></span>
        <span class="line">→ <span class="hl-2">cargo</span> watching for changes…</span>
      </div>
    </div>

    <div class="block">
      <div class="block-head">
        <span class="block-status block-status-running" aria-hidden="true"></span>
        <span class="block-cmd">
          <span class="prompt">$</span>
          <span>claude "review the OSC 133 parser"</span>
        </span>
        <span class="block-time">live</span>
      </div>
      <div class="block-out">
        <span class="line">Reading <span class="hl">src/components/terminal/osc133.ts</span>…</span>
        <span class="line">Found <span class="num">3</span> handler registrations.</span>
        <span class="line typing"><span class="caret"></span></span>
      </div>
    </div>
  </div>
</div>

<style>
  .term {
    background: linear-gradient(180deg, #0d1424 0%, #0a0f1d 100%);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.7),
      0 1px 0 rgba(255, 255, 255, 0.05) inset;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.55;
  }
  .term-chrome {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border);
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.3) inset;
  }
  .dot-r { background: #ff5f57; }
  .dot-y { background: #febc2e; }
  .dot-g { background: #28c840; }
  .term-title {
    margin-left: 8px;
    color: var(--fg-dim);
    font-size: 11px;
    letter-spacing: 0.02em;
  }
  .term-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .block {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.02);
  }
  .block-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }
  .block-status {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .block-status-ok {
    background: var(--success);
    box-shadow: 0 0 8px color-mix(in oklab, var(--success) 70%, transparent);
  }
  .block-status-running {
    background: var(--accent);
    box-shadow: 0 0 8px color-mix(in oklab, var(--accent) 70%, transparent);
    animation: pulse 1.6s var(--ease-out) infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .block-cmd {
    flex: 1;
    color: var(--fg);
    font-weight: 500;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .prompt {
    color: var(--accent);
    margin-right: 8px;
    font-weight: 600;
  }
  .block-time {
    color: var(--fg-dim);
    font-size: 11px;
    flex-shrink: 0;
  }
  .block-out {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .line {
    color: var(--fg);
    white-space: pre;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .line.muted { color: var(--fg-muted); }
  .hl { color: var(--accent); }
  .hl-2 { color: #f59e0b; }
  .num { color: #f472b6; }
  .typing { min-height: 1.55em; }
  .caret {
    display: inline-block;
    width: 7px;
    height: 14px;
    background: var(--fg);
    vertical-align: text-bottom;
    animation: blink 1s steps(2, end) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
</style>
