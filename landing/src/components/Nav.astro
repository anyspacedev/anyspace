---
import BrandMark from "./BrandMark.astro";
import ThemeToggle from "./ThemeToggle.tsx";

const pathname = Astro.url.pathname;
const isDocs = pathname.startsWith("/docs");

const links = [
  { href: "/#cli-workspace", label: "Features", match: () => false },
  { href: "/#team", label: "Team Mode", match: () => false },
  { href: "/#pricing", label: "Pricing", match: () => false },
  { href: "/docs", label: "Docs", match: () => isDocs },
  { href: "/#faq", label: "FAQ", match: () => false },
];
---

<header
  data-nav
  class="sticky top-0 z-50 border-b border-transparent bg-bg/75 backdrop-blur-md transition-[border-color] duration-fast ease-out data-[scrolled]:border-border"
>
  <div class="container flex h-16 items-center gap-8">
    <a href="/" class="inline-flex items-center gap-2.5" aria-label="AnySpace home">
      <BrandMark size={26} class="rounded-md" />
      <span class="text-base font-semibold tracking-tight text-fg">AnySpace</span>
    </a>

    <nav aria-label="Primary" class="hidden flex-1 items-center gap-7 sm:flex">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={l.match() ? "page" : undefined}
          class:list={[
            "text-sm font-medium transition-colors duration-fast",
            l.match() ? "text-fg" : "text-fg-muted hover:text-fg",
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href="https://github.com/anyspacedev/anyspace"
        rel="noopener"
        aria-label="View on GitHub"
        class="hidden h-9 items-center justify-center rounded-md border border-border px-3 text-fg-muted transition-colors duration-fast hover:border-border-strong hover:text-fg sm:inline-flex"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.16-.02-2.11-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.27-1.68-1.27-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.34.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.16 1.18.92-.26 1.9-.39 2.88-.39.98 0 1.96.13 2.88.39 2.2-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.13 0 1.54-.01 2.78-.01 3.16 0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" />
        </svg>
      </a>
      <ThemeToggle client:load />
      <a
        href="#download"
        data-os-cta
        class="inline-flex h-9 items-center justify-center rounded-md bg-fg px-4 text-sm font-medium text-bg transition-colors duration-fast hover:bg-fg/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
      >
        <span data-nav-download>Download</span>
      </a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector("[data-nav]") as HTMLElement | null;
  if (nav) {
    const onScroll = () => {
      if (window.scrollY > 8) nav.setAttribute("data-scrolled", "");
      else nav.removeAttribute("data-scrolled");
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
