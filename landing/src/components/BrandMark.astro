---
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = "" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 160 160"
  aria-hidden="true"
  class:list={["brand-mark-svg", className]}
>
  <rect x="0" y="0" width="160" height="160" rx="36" class="brand-tile" />
  <circle cx="20" cy="20" r="4" class="brand-dot" opacity="0.9" />
  <circle cx="34" cy="20" r="4" class="brand-dot" opacity="0.6" />
  <circle cx="48" cy="20" r="4" class="brand-dot" opacity="0.4" />
  <rect x="20" y="40" width="55" height="50" rx="6" class="brand-pane" opacity="0.95" />
  <rect x="85" y="40" width="55" height="50" rx="6" class="brand-pane" opacity="0.55" />
  <rect x="20" y="100" width="120" height="40" rx="6" class="brand-pane" opacity="0.75" />
</svg>

<style>
  .brand-mark-svg .brand-tile {
    fill: #0a0a0a;
  }
  .brand-mark-svg .brand-dot,
  .brand-mark-svg .brand-pane {
    fill: #ffffff;
  }
  :global(.dark) .brand-mark-svg .brand-tile {
    fill: #fafafa;
  }
  :global(.dark) .brand-mark-svg .brand-dot,
  :global(.dark) .brand-mark-svg .brand-pane {
    fill: #0a0a0a;
  }
</style>
