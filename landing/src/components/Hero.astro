---
import TerminalMockup from "./TerminalMockup.astro";
---

<section class="hero" id="download">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">v0.1 — early access</span>
      <h1>
        Your terminal, editor, and <span class="grad">agents</span> in one window.
      </h1>
      <p class="lead">
        Teamship is a native desktop workspace for developers: multi-pane
        terminals with Warp-style command blocks, Monaco editor, live preview,
        and AI agent orchestration — all wired together so your tools stop
        fighting each other.
      </p>

      <div class="hero-cta">
        <a href="#download-link" class="btn btn-primary" data-download-cta>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span data-download-label>Download for your platform</span>
        </a>
        <a href="https://github.com" class="btn btn-ghost" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.7.5.6 5.6.6 12c0 5 3.3 9.3 7.8 10.8.6.1.8-.2.8-.6v-2.2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2 1-.3 2-.4 3-.4s2 .1 3 .4c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.7.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.5-1.5 7.8-5.8 7.8-10.8C23.4 5.6 18.3.5 12 .5z" />
          </svg>
          <span>Star on GitHub</span>
        </a>
      </div>

      <ul class="hero-meta" aria-label="Platform support">
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16.5 2.1c0 1.4-.6 2.7-1.5 3.7-.9 1-2.1 1.6-3.3 1.5-.1-1.4.5-2.7 1.4-3.6 1-1 2.3-1.6 3.4-1.6zM18.7 12.5c0-2 1.7-3 1.8-3.1-1-1.4-2.5-1.6-3-1.7-1.3-.1-2.5.8-3.1.8-.6 0-1.6-.7-2.7-.7-1.4 0-2.7.8-3.4 2-1.5 2.5-.4 6.3 1 8.4.7 1 1.5 2.1 2.6 2.1 1 0 1.4-.7 2.7-.7 1.2 0 1.6.7 2.7.7 1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3 0 0-2.2-.8-2.2-3.5z" />
          </svg>
          macOS 11+
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3 5l9-1.5V12H3V5zm9 7.5h9V3.5l-9 1.5v7.5zM3 13h9v6.5L3 18v-5zm9 0h9v8.5L12 20v-7z" />
          </svg>
          Windows 10+
        </li>
        <li>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2c-2 0-3 2-3 4v2c-1 1-2 2-2 4 0 1 1 2 1 3l-2 4c-1 2 1 3 3 3 1 0 2-1 2-1s1 1 2 1c2 0 4-1 3-3l-2-4c0-1 1-2 1-3 0-2-1-3-2-4V6c0-2-1-4-3-4z" />
          </svg>
          Linux (deb / AppImage)
        </li>
      </ul>
    </div>

    <div class="hero-mockup" aria-hidden="false">
      <TerminalMockup />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(48px, 8vw, 96px);
    position: relative;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }
  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: 1.05fr 1fr;
    }
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .grad {
    background: linear-gradient(120deg, var(--accent) 20%, #818cf8 80%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 8px;
  }
  .hero-meta {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    margin-top: 8px;
    font-size: 13px;
    color: var(--fg-dim);
  }
  .hero-meta li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero-mockup {
    width: 100%;
    transform: rotate(-0.5deg);
  }
  @media (min-width: 980px) {
    .hero-mockup {
      transform: rotate(0.5deg);
    }
  }
</style>

<script is:inline>
  // Auto-detect OS for the primary CTA label.
  (() => {
    const label = document.querySelector("[data-download-label]");
    if (!label) return;
    const ua = navigator.userAgent;
    let os = "your platform";
    if (/Mac|iPhone|iPad/.test(ua)) os = "macOS";
    else if (/Win/.test(ua)) os = "Windows";
    else if (/Linux/.test(ua)) os = "Linux";
    label.textContent = `Download for ${os}`;
  })();
</script>
