---
import type { DocEntry } from "../../lib/docs";

interface Props {
  prev: DocEntry | null;
  next: DocEntry | null;
}
const { prev, next } = Astro.props;
---

<nav aria-label="Pagination" class="mt-16 grid grid-cols-1 gap-3 border-t border-border pt-8 sm:grid-cols-2">
  {prev ? (
    <a
      href={`/docs/${prev.id}`}
      class="group flex flex-col rounded-lg border border-border bg-bg p-4 transition-colors duration-fast hover:border-border-strong"
    >
      <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-fg-dim">← Previous</span>
      <span class="mt-1 font-medium text-fg">{prev.data.title}</span>
    </a>
  ) : (
    <span aria-hidden="true"></span>
  )}
  {next ? (
    <a
      href={`/docs/${next.id}`}
      class="group flex flex-col rounded-lg border border-border bg-bg p-4 text-right transition-colors duration-fast hover:border-border-strong sm:col-start-2"
    >
      <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-fg-dim">Next →</span>
      <span class="mt-1 font-medium text-fg">{next.data.title}</span>
    </a>
  ) : (
    <span aria-hidden="true"></span>
  )}
</nav>
