---
const steps = [
  {
    n: "01",
    title: "Open your project.",
    body: "Pick any folder. Teamship spawns terminals already in the right cwd, with shell integration injected via $BASH_ENV — zero rc-file changes.",
  },
  {
    n: "02",
    title: "Pick an agent, or write your own.",
    body: "Ship-with templates for Claude Code, Codex, Cursor CLI. Or define a command template with {task_file} substitution and your own system prompt.",
  },
  {
    n: "03",
    title: "Ship.",
    body: "Drag a Kanban task to a pane. The agent runs with task context injected. Watch it work, intervene with Right-Ctrl dictation, broadcast keystrokes to every selected pane.",
  },
];
---

<section class="section how" id="how">
  <div class="container">
    <header class="section-head">
      <span class="eyebrow">How it works</span>
      <h2>Three steps from a fresh repo to an agent that's already shipping.</h2>
    </header>

    <ol class="steps">
      {
        steps.map((s) => (
          <li class="step card">
            <span class="step-num">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    counter-reset: step;
  }
  @media (min-width: 880px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px 28px;
  }
  .step-num {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    letter-spacing: 0.06em;
  }
  .step p {
    color: var(--fg-muted);
    font-size: 15px;
  }
</style>
