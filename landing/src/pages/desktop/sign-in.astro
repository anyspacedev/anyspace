---
import Base from "../../layouts/Base.astro";
import DesktopSignIn from "../../components/islands/DesktopSignIn.tsx";

const title = "Sign in to AnySpace desktop";
const description = "Browser sign-in bridge for the AnySpace desktop app.";

// Public-by-design defaults — the Clerk publishable key ships in every
// client bundle anyway, and the API URL is the production endpoint. They
// live here (and as a mirror in wrangler.jsonc `vars`) so an auto-deploy
// from a fresh build environment can never produce a bundle missing them.
// Override via .env / CI env / dashboard build vars for staging/local.
//
// `||` (not `??`) because Vite replaces an unset `import.meta.env.PUBLIC_X`
// with an empty string, which `??` would treat as a real value.
const DEFAULT_CLERK_KEY = "pk_live_Y2xlcmsuYW55c3BhY2UuZGV2JA";
const DEFAULT_API_BASE = "https://api.anyspace.dev";

const publishableKey =
  (import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY as string | undefined) ||
  DEFAULT_CLERK_KEY;
const apiBase =
  (import.meta.env.PUBLIC_ANYSPACE_API_URL as string | undefined) ||
  DEFAULT_API_BASE;
---

<Base title={title} description={description}>
  <!-- This page only exists to ferry a sign-in ticket back to the desktop
       app's loopback listener; we don't want it in search results. -->
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <main id="main" class="min-h-screen bg-bg">
    <DesktopSignIn
      client:only="react"
      publishableKey={publishableKey}
      apiBase={apiBase}
    />
  </main>
</Base>
