---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const title = "Terms of Service — AnySpace";
const description =
  "The agreement between you and Rebase LLC for use of the AnySpace desktop app, this website, and AnySpace Cloud.";
const lastUpdated = "May 11, 2026";
---

<Base title={title} description={description}>
  <Nav />
  <main id="main" class="py-16 sm:py-20">
    <div class="container">
      <div class="mx-auto max-w-3xl">
        <aside
          class="mb-10 rounded-lg border border-border bg-bg-elev px-4 py-3 font-mono text-xs text-fg-muted"
          role="note"
          aria-label="Draft notice"
        >
          <strong class="text-fg">Draft — pending legal review.</strong>
          This document is a placeholder so the footer links resolve. It has not
          been reviewed by counsel and is not yet in force. Final language will
          replace it before any paid signup or production cloud feature ships.
        </aside>

        <p class="mb-2 font-mono text-xs uppercase tracking-[0.14em] text-fg-dim">
          Last updated: {lastUpdated}
        </p>

        <article class="docs-prose">
          <h1>Terms of Service</h1>
          <p>
            These Terms of Service ("Terms") govern your access to and use of
            the AnySpace desktop application, the AnySpace website, and
            AnySpace Cloud (together, the "Service"), operated by{" "}
            <strong>Rebase LLC</strong> ("AnySpace", "we", "us"). By
            downloading, installing, or using the Service, you agree to these
            Terms. If you do not agree, do not use the Service.
          </p>

          <h2>1. Eligibility</h2>
          <p>
            You must be at least 16 years old to use the Service. If you use
            the Service on behalf of an organization, you represent that you
            have authority to bind that organization to these Terms, and
            references to "you" include that organization.
          </p>

          <h2>2. The Service</h2>
          <p>The Service consists of:</p>
          <ul>
            <li>
              The <strong>AnySpace desktop app</strong> — a local-first
              workspace for terminals, editors, previews, and AI agents that
              runs on your machine.
            </li>
            <li>
              This <strong>website</strong>, including documentation and
              account management.
            </li>
            <li>
              <strong>AnySpace Cloud</strong> — an optional managed endpoint
              for AI and speech-to-text requests.
            </li>
          </ul>
          <p>
            The Service is provided as described in the documentation. We may
            modify, add, or remove features at any time. We will give
            reasonable notice of material changes that adversely affect paid
            plans.
          </p>

          <h2>3. Your account</h2>
          <p>
            Some features require an account. Authentication is provided by
            Clerk. You are responsible for keeping your credentials secure and
            for all activity under your account. Notify us promptly at{" "}
            <a href="mailto:support@anyspace.dev">support@anyspace.dev</a> if
            you suspect unauthorized access.
          </p>

          <h2>4. License to use the AnySpace app</h2>
          <p>
            Subject to your compliance with these Terms, we grant you a
            limited, non-exclusive, non-transferable, revocable license to
            install and use the AnySpace desktop app for your personal or
            internal business purposes. You may not:
          </p>
          <ul>
            <li>
              Resell, sublicense, or distribute the app or AnySpace Cloud
              access to third parties.
            </li>
            <li>
              Reverse engineer, decompile, or disassemble the app except to the
              extent permitted by applicable law.
            </li>
            <li>
              Remove or alter any proprietary notices or branding within the
              app.
            </li>
            <li>
              Use the app to build a competing product, or to train a model
              intended to replicate AnySpace functionality.
            </li>
          </ul>
          <p>
            If portions of the Service are made available under an open-source
            license, those portions are governed by that license, which
            controls over these Terms to the extent of any conflict.
          </p>

          <h2>5. Your content and data</h2>
