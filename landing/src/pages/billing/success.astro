---
import Base from "../../layouts/Base.astro";

const title = "AnySpace Pro — Welcome";
const description = "Your subscription is being finalised — head back to AnySpace.";
---

<Base title={title} description={description}>
  <!-- Post-checkout landing page; not useful in search results. -->
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <section class="pt-28 pb-32 sm:pt-36 sm:pb-40">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow mb-5">Subscription</p>
        <h1 class="text-display text-fg">
          You're on AnySpace
          <span class="text-fg-muted">Pro.</span>
        </h1>
        <p class="mx-auto mt-7 max-w-xl text-balance text-base text-fg-muted sm:text-lg">
          We're finalising your subscription with Stripe. AnySpace will switch
          over within a few seconds &mdash; you can close this tab and head
          back to the app. Manage your subscription anytime from
          <strong class="text-fg">Settings &rarr; Subscription</strong>.
        </p>
        <div class="mt-8 flex justify-center gap-3">
          <button
            id="close-tab"
            type="button"
            class="inline-flex h-11 items-center justify-center rounded-lg bg-fg px-5 text-sm font-medium text-bg transition-colors duration-fast hover:bg-fg/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
          >
            Close tab
          </button>
          <a
            href="/"
            class="inline-flex h-11 items-center justify-center rounded-lg border border-border-strong bg-transparent px-5 text-sm font-medium text-fg transition-colors duration-fast hover:bg-bg-elev focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
          >
            Back to anyspace.dev
          </a>
        </div>
        <p class="mx-auto mt-10 max-w-md text-xs text-fg-dim">
          Receipts are sent automatically by Stripe. Need a refund? Email
          <a href="mailto:hi@anyspace.dev" class="underline underline-offset-2 hover:text-fg">hi@anyspace.dev</a>
          within 30 days.
        </p>
      </div>
    </div>
  </section>

  <script>
    // Most browsers block window.close() unless the tab was opened via JS —
    // Stripe Checkout opens us via redirect, so this usually silently no-ops
    // and the user falls back to the visible "Back to anyspace.dev" link.
    document.getElementById("close-tab")?.addEventListener("click", () => {
      window.close();
    });
  </script>
</Base>
