# Copy to .env for `astro dev`. Production values go in Cloudflare Pages env
# (or wrangler.jsonc `vars` block for `wrangler deploy`).

# Clerk publishable key (safe to expose — it's how the SignIn component
# locates the Clerk Frontend API). Same value the desktop app's
# VITE_CLERK_PUBLISHABLE_KEY uses.
PUBLIC_CLERK_PUBLISHABLE_KEY=

# Anyspace backend base URL — bridge page POSTs to
# {PUBLIC_ANYSPACE_API_URL}/v1/desktop-bridge/mint-ticket after sign-in.
PUBLIC_ANYSPACE_API_URL=https://api.anyspace.dev
