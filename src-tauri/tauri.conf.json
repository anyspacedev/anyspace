{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnySpace",
  "version": "0.1.0",
  "identifier": "dev.anyspace.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AnySpace",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Orchestrate AI agents across multi-pane workspaces",
    "longDescription": "AnySpace — terminal, task board, and agents unified in one native app for vibe coding."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://api.anyspace.dev/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": false,
      "pubkey": ""
    }
  }
}
